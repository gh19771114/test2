    "philosophy": {
      "title": "企业理念",
      "subtitle": "Corporate Philosophy",
      "description": "Bourn Mark 根植日本、服务中日。我们在不动产、企业服务与资本运营之间寻找长期平衡，以诚信、专业与跨文化理解为核心，持续推进城市更新、资产运营与商务合作的共赢。我们以诚挚的态度陪伴客户走过每一个阶段，让资产、企业与团队在日本不断成长，并持续为地区发展注入活力。",
      "ourPhilosophy": {
        "title": "我们的理念",
        "description": "我们深耕日本市场，致力于用专业与诚信搭建中日合作的桥梁。从不动产到企业投资，我们坚持以长期价值为导向，将城市更新、资产运营与商务整合紧密结合，为客户与伙伴创造可持续的成长空间。"
      },
      "values": {
        "value1": {
          "title": "中日桥梁",
          "description": "根植日本、服务华语市场，搭建中日企业与投资者之间透明顺畅的沟通与合作渠道。"
        },
        "value2": {
          "title": "城市更新",
          "description": "关注城市更新与资产运营价值，用精细化管理推动社区与资产的长期成长。"
        },
        "value3": {
          "title": "诚信专业",
          "description": "以诚信、合规与专业判断为底线，长期守护客户与伙伴的信任与成果。"
        },
        "value4": {
          "title": "资源整合",
          "description": "跨文化、跨领域整合多方资源，推动中日企业交流合作与创新业务的共同发展。"
        }
      },
      "mission": {
        "title": "我们的使命",
        "description": "「通过跨文化协作，让中日商务与不动产服务互相成就。」我们以透明沟通、专业判断与数字化管理，帮助客户稳健拓展在日业务，同时推动合作伙伴在新生态中实现价值递增。",
        "longTermValue": {
          "title": "长期价值",
          "description": "审慎配置资产、强化风险控制，以可持续收益与品牌影响力回应客户期待。"
        },
        "collaborativeNetwork": {
          "title": "协同网络",
          "description": "整合金融、法律、政府与行业伙伴资源，打造开放共享的跨境服务平台。"
        }
      }
    },
    "history": {
      "title": "企业沿革",
      "subtitle": "Company History",
      "description": "自 2009 年成立以来，Bourn Mark 持续深化日本不动产与跨境服务版图：从租赁买卖、资产增值到企业投资，与中日企业共同成长，构建扎实的城市运营与资本运作经验。",
      "milestones": {
        "milestone1": {
          "year": "2009.06",
          "title": "公司成立",
          "description": "川雨流痕股份有限公司（当时社名：株式会社暖灯）在东京成立，开启专注华语客户的日本不动产业务。",
          "imageAlt": "初创阶段的办公环境"
        },
        "milestone2": {
          "year": "2010.01",
          "title": "总部设立",
          "description": "在东京都荒川区设立总公司，构建最初的租赁与买卖顾问团队，并同年 10 月开设日暮里站前店。",
          "imageAlt": "东京城区街景"
        },
        "milestone3": {
          "year": "2012.01",
          "title": "区域拓展",
          "description": "川口店开业，服务圈扩大至埼玉及首都圈北部；同年 9 月正式进入台湾市场。",
          "imageAlt": "跨区域交通枢纽"
        },
        "milestone4": {
          "year": "2015.03",
          "title": "业务升级",
          "description": "开拓不动产增值业务与国际不动产业务，拓展服务领域与市场范围。",
          "imageAlt": "现代城市商务楼宇"
        },
        "milestone5": {
          "year": "2015.08",
          "title": "海外拓展",
          "description": "在上海设立当地法人公司，进一步拓展中国市场，建立跨境业务网络。",
          "imageAlt": "上海商务区"
        },
        "milestone6": {
          "year": "2015.12",
          "title": "购入总部大楼",
          "description": "购入自有总部办公大楼，确立公司在日本市场的稳固根基。",
          "imageAlt": "总部办公大楼"
        },
        "milestone7": {
          "year": "2016.03",
          "title": "总部迁移",
          "description": "总部迁至东京都中央区，进一步贴近日本桥金融商务区，夯实跨境业务据点。",
          "imageAlt": "日本桥金融区"
        },
        "milestone8": {
          "year": "2017.04",
          "title": "资本强化",
          "description": "公司注册资本增资至 2,500 万日元，并在 10 月推出首个自有公寓项目 \"WARMLIGHT RESIDENCE\"。",
          "imageAlt": "现代公寓建筑"
        },
        "milestone9": {
          "year": "2018.02",
          "title": "资产扩张",
          "description": "收购 \"京都乌丸六条酒店\"，进入酒店与商用资产运营领域。",
          "imageAlt": "酒店大堂"
        },
        "milestone10": {
          "year": "2021.04",
          "title": "战略协同",
          "description": "与 Helte 公司展开业务及资本合作，结合数字化与社区运营优势。",
          "imageAlt": "团队协作会议"
        },
        "milestone11": {
          "year": "2021.06",
          "title": "品牌焕新",
          "description": "公司正式更名为川雨流痕股份有限公司（Bourn Mark CO., LTD.），确立\"根植日本、连接中日\"的企业定位。",
          "imageAlt": "品牌发布活动"
